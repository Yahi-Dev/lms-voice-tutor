{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/lmstutor.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "DemoData": true
  },
  "Auth": {
    "CookieSecurePolicy": "SameAsRequest",
    "LockoutMinutes": 2,
    "MaxFailedAccessAttempts": 5
  }
}
