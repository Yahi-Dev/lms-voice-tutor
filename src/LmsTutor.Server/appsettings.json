{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/lmstutor.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "DemoData": true
  },
  "Auth": {
    "CookieSecurePolicy": "SameAsRequest",
    "LockoutMinutes": 2,
    "MaxFailedAccessAttempts": 5
  },
  "Tutoring": {
    "Provider": "Auto",
    "BaseUrl": "https://api.groq.com/openai/v1/",
    "Model": "openai/gpt-oss-120b",
    "FallbackModel": "openai/gpt-oss-20b",
    "Temperature": 0.6,
    "MaxCompletionTokens": 1500,
    "ReasoningEffort": "low",
    "HistoryTurns": 4,
    "MaxQuestionLength": 500,
    "FakeLatencyMilliseconds": 600,
    "FakeFailure": "None"
  },
  "Speech": {
    "Provider": "Auto",
    "BaseUrl": "https://api.groq.com/openai/v1/",
    "Model": "whisper-large-v3-turbo",
    "Language": "es",
    "MaxUploadBytes": 5000000,
    "FakeTranscript": "¿Para qué sirve POST?",
    "FakeLatencyMilliseconds": 500,
    "FakeFailure": "None"
  },
  "RateLimiting": {
    "TutorRequestsPerMinute": 10,
    "SpeechRequestsPerMinute": 10,
    "LoginAttemptsPerMinute": 10
  }
}
