# Copy this file to .env (never commit .env).

# Free Groq API key from https://console.groq.com/keys (no credit card needed).
# Leave it empty to run in demo mode: the tutor and the transcription use built-in simulated providers.
Tutoring__ApiKey=

# Host port for http://localhost:<port>. The microphone only works on localhost or HTTPS.
APP_PORT=8080
